set(BUILD_SDL3 ON CACHE BOOL "" FORCE)
set(TRACING_SUPPORT OFF CACHE BOOL "" FORCE)
set(BUILD_DXVK_NATIVE OFF CACHE BOOL "" FORCE)

set(SDL3_INCLUDE_DIRS "${SDL3_SOURCE_DIR}/include")
set(SDL3_LIBRARIES SDL3-shared)

set(CMAKE_SKIP_INSTALL_RULES ON)
add_subdirectory("${LIBS_DIR}/FNA3D" "${CMAKE_BINARY_DIR}/external/FNA3D")
if(BUILD_SDL3)
    target_compile_definitions(FNA3D PRIVATE SDL_setenv=SDL_setenv_unsafe)
endif()
set(CMAKE_SKIP_INSTALL_RULES OFF)
