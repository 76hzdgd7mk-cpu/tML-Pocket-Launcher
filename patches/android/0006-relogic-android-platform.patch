+using System;
+using System.IO;
+using ReLogic.Localization.IME;
+
+namespace ReLogic.OS
+{
+
+public interface IAndroidPlatformServices
+{
+	string FilesDirectory { get; }
+	string CacheDirectory { get; }
+	bool OpenUrl(string url);
+	string GetClipboardText();
+	void SetClipboardText(string text);
+	void SetOrientation(bool landscape);
+	void SetImeVisible(bool visible);
+	void AddImeTextListener(Action<char> listener);
+	void RemoveImeTextListener(Action<char> listener);
+}
+
+public static class AndroidPlatformServices
+{
+	private static IAndroidPlatformServices _current = new EnvironmentAndroidPlatformServices();
+	public static IAndroidPlatformServices Current => _current;
+	public static void Configure(IAndroidPlatformServices services) => _current = services ?? throw new ArgumentNullException(nameof(services));
+
+	private sealed class EnvironmentAndroidPlatformServices : IAndroidPlatformServices
+	{
+		public string FilesDirectory => Environment.GetEnvironmentVariable("TML_ANDROID_FILES") ?? Environment.GetEnvironmentVariable("XDG_DATA_HOME") ?? Directory.GetCurrentDirectory();
+		public string CacheDirectory => Environment.GetEnvironmentVariable("TML_ANDROID_CACHE") ?? Path.Combine(FilesDirectory, "cache");
+		public bool OpenUrl(string url) => false;
+		public string GetClipboardText() => string.Empty;
+		public void SetClipboardText(string text) { }
+		public void SetOrientation(bool landscape) { }
+		public void SetImeVisible(bool visible) { }
+		public void AddImeTextListener(Action<char> listener) { }
+		public void RemoveImeTextListener(Action<char> listener) { }
+	}
+}
+
+}
+
+namespace ReLogic.OS.Android
+{
+
+internal sealed class AndroidPlatform : Platform
+{
+	public AndroidPlatform() : base(PlatformType.Android)
+	{
+		RegisterService((IClipboard)new Clipboard());
+		RegisterService((IPathService)new PathService());
+		RegisterService((IWindowService)new WindowService());
+		RegisterService((IImeService)new UnsupportedPlatformIme());
+	}
+
+	public override void InitializeClientServices(IntPtr windowHandle) => RegisterService((IImeService)new AndroidIme());
+}
+
+internal sealed class Clipboard : ReLogic.OS.Base.Clipboard
+{
+	protected override string GetClipboard() => AndroidPlatformServices.Current.GetClipboardText();
+	protected override void SetClipboard(string text) => AndroidPlatformServices.Current.SetClipboardText(text);
+}
+
+internal sealed class PathService : ReLogic.OS.Base.PathService
+{
+	public override string GetStoragePath() => AndroidPlatformServices.Current.FilesDirectory;
+	public override void OpenURL(string url)
+	{
+		if (!AndroidPlatformServices.Current.OpenUrl(url))
+			throw new InvalidOperationException("Android URL bridge is not configured.");
+	}
+
+	public override bool MoveToRecycleBin(string path)
+	{
+		string root = Path.GetFullPath(GetStoragePath()).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+		string fullPath = Path.GetFullPath(path);
+		if (!fullPath.StartsWith(root, StringComparison.OrdinalIgnoreCase))
+			return false;
+		if (File.Exists(fullPath)) File.Delete(fullPath);
+		return true;
+	}
+}
+
+internal sealed class WindowService : IWindowService
+{
+	public void SetUnicodeTitle(Microsoft.Xna.Framework.GameWindow window, string title) => window.Title = title;
+	public void StartFlashingIcon(Microsoft.Xna.Framework.GameWindow window) { }
+	public void StopFlashingIcon(Microsoft.Xna.Framework.GameWindow window) { }
+	public float GetScaling() => 1f;
+	public void SetQuickEditEnabled(bool enabled) { }
+	public void SetLandscape(bool landscape) => AndroidPlatformServices.Current.SetOrientation(landscape);
+	public void HideConsole() { }
+	public void ShowConsole() { }
+	public void ReleaseConsole() { }
+	public void CreateAndRedirectConsole() { }
+}
+
+}
+
+namespace ReLogic.Localization.IME
+{
+
+internal sealed class AndroidIme : PlatformIme
+{
+	public AndroidIme() => ReLogic.OS.AndroidPlatformServices.Current.AddImeTextListener(OnKeyPress);
+	public override uint CandidateCount => 0u;
+	public override string CompositionString => string.Empty;
+	public override bool IsCandidateListVisible => false;
+	public override uint SelectedCandidate => 0u;
+	public override string GetCandidate(uint index) => string.Empty;
+	protected override void OnEnable() => ReLogic.OS.AndroidPlatformServices.Current.SetImeVisible(true);
+	protected override void OnDisable() => ReLogic.OS.AndroidPlatformServices.Current.SetImeVisible(false);
+	protected override void Dispose(bool disposing)
+	{
+		if (disposing) ReLogic.OS.AndroidPlatformServices.Current.RemoveImeTextListener(OnKeyPress);
+		base.Dispose(disposing);
+	}
+}
+}
