<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MobileLauncher.Stores</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.5.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <!-- GOG's distributed installed-client parameters, matching the reference launcher. -->
    <EmbeddedResource Include="GogClient.json" />
  </ItemGroup>
</Project>
