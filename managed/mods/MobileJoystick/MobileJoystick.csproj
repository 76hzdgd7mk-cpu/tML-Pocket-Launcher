<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MobileJoystick</AssemblyName>
    <DefineConstants>$(DefineConstants);TML_2026_09</DefineConstants>
    <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="../../../build/game-references/*.dll" Private="false" />
    <Reference Include="../../../external/monomod/*.dll" Private="false" />
  </ItemGroup>
</Project>
